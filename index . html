};

const app = initializeApp(firebaseConfig);
const db = getFirestore(app);

window.saveToFirebase = async function(name, roomName, roomId, password, entryFee) {
    try {
        await addDoc(collection(db, "joinedPlayers"), {
            name: name, roomName: roomName, roomId: roomId,
            password: password, entryFee: entryFee, timestamp: new Date()
        });
        console.log("✅ Data Saved!");
    } catch (e) { console.error("❌ Error:", e); }
};

window.saveResultToFirebase = async function(player1, player2, winner) {
    try {
        await addDoc(collection(db, "matchResults"), {
            player1: player1, player2: player2, winner: winner,
            status: "pending", timestamp: new Date()
        });
        console.log("✅ Result Saved!");
    } catch (e) { console.error("❌ Error:", e); }
};

window.getPendingResults = async function() {
    var results = [];
    try {
        var q = query(collection(db, "matchResults"), where("status", "==", "pending"));
        var snap = await getDocs(q);
        snap.forEach(function(d) {
            var data = d.data();
            results.push({ id: d.id, player1: data.player1, player2: data.player2, winner: data.winner });
        });
    } catch (e) { console.error("❌ Error:", e); }
    return results;
};

window.updateResultStatus = async function(id, status) {
    try {
        await updateDoc(doc(db, "matchResults", id), { status: status });
        console.log("✅ Result " + status);
    } catch (e) { console.error("❌ Error:", e); }
};
</script>


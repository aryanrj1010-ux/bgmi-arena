<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BGMI Arena</title>
<style>
* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0f172a; color: white; }
header { background: #1e293b; padding: 14px; text-align: center; position: sticky; top: 0; z-index: 100; }
h1 { margin: 0; font-size: 22px; }
.container { max-width: 600px; margin: auto; padding: 12px; }
.card { background: #1e293b; padding: 16px; margin-bottom: 12px; border-radius: 15px; }
h2 { text-align: center; margin-top: 0; font-size: 19px; }
input, select { width: 100%; padding: 13px; margin: 6px 0; border: 0; border-radius: 8px; font-size: 15px; background: #273449; color: white; }
button { width: 100%; padding: 13px; margin-top: 8px; border: 0; border-radius: 8px; background: #2563eb; color: white; font-size: 15px; font-weight: 600; }
button:active { transform: scale(0.98); }
.hidden { display: none !important; }
.room { background: #273449; padding: 14px; margin-top: 12px; border-radius: 12px; }
.join { background: #16a34a; }
.timer-text { text-align: center; color: #f59e0b; font-size: 38px; margin: 5px 0; font-weight: bold; }
.lb-row { display: flex; align-items: center; padding: 10px 0; border-bottom: 1px solid #334155; }
.lb-rank { width: 35px; font-weight: bold; color: #f59e0b; }
.lb-name { flex: 1; font-size: 14px; }
.lb-wins { color: #22c55e; font-size: 13px; margin-right: 10px; }
.tab-bar { display: flex; gap: 8px; margin-bottom: 12px; }
.tab-btn { flex: 1; padding: 12px; background: #273449; border-radius: 8px; text-align: center; font-weight: bold; cursor: pointer; font-size: 14px; }
.tab-btn.active { background: #2563eb; }
.detail-row { display: flex; justify-content: space-between; align-items: center; background: #1e293b; padding: 12px; border-radius: 10px; margin-bottom: 10px; }
.detail-label { color: #94a3b8; font-size: 14px; }
.detail-value { color: white; font-weight: bold; font-size: 16px; }
.copy-btn { background: #2563eb; padding: 6px 12px; border-radius: 6px; font-size: 12px; margin-left: 10px; cursor: pointer; border: 0; color: white; width: auto; }
.big-btn { padding: 16px; font-size: 16px; font-weight: bold; border-radius: 12px; margin-top: 12px; }
.open-bgmi-btn { background: linear-gradient(135deg, #f59e0b, #d97706); }
.loading-text { text-align: center; color: #94a3b8; padding: 15px; }
</style>
</head>
<body>

<header><h1>🎮 BGMI ARENA</h1></header>

<div class="container">

<!-- LOGIN PAGE -->
<div class="card" id="loginBox">
<h2>🔐 Login</h2>
<input type="text" id="username" placeholder="Enter your name">
<button onclick="login()">Login</button>
<button style="background:#475569;" onclick="adminMode()">🛠️ Admin Login</button>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BGMI Arena</title>
<style>
* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0f172a; color: white; }
header { background: #1e293b; padding: 16px; text-align: center; }
h1 { margin: 0; font-size: 24px; }
.container { max-width: 600px; margin: auto; padding: 12px; }
.card { background: #1e293b; padding: 16px; margin-bottom: 12px; border-radius: 15px; }
h2 { text-align: center; margin-top: 0; font-size: 19px; }
input, select { width: 100%; padding: 13px; margin: 6px 0; border: 0; border-radius: 8px; font-size: 15px; background: #273449; color: white; }
button { width: 100%; padding: 13px; margin-top: 8px; border: 0; border-radius: 8px; background: #2563eb; color: white; font-size: 15px; font-weight: 600; }
.hidden { display: none !important; }
.room { background: #273449; padding: 14px; margin-top: 12px; border-radius: 12px; }
.join { background: #16a34a; }
.timer-text { text-align: center; color: #f59e0b; font-size: 40px; margin: 5px 0; font-weight: bold; }
.lb-row { display: flex; align-items: center; padding: 10px 0; border-bottom: 1px solid #334155; }
.lb-rank { width: 35px; font-weight: bold; color: #f59e0b; }
.lb-name { flex: 1; font-size: 14px; }
.lb-wins { color: #22c55e; font-size: 13px; margin-right: 10px; }
</style>
</head>
<body>

<header><h1>🎮 BGMI ARENA</h1></header>

<div class="container">

<div class="card" id="loginBox">
<h2>🔐 Login</h2>
<input type="text" id="username" placeholder="Enter your name">
<button onclick="login()">Login</button>
<button style="background:#475569;" onclick="adminMode()">🛠️ Admin Login</button>
</div>

<div class="card hidden" id="adminBox">
<h2>🛠️ Admin Login</h2>
<input type="password" id="adminPassword" placeholder="Password">
<button onclick="adminLogin()">Login</button>
<button style="background:#475569;" onclick="showMain()">⬅️ Back</button>
</div>

<div class="card hidden" id="adminPanel">
<h2>🛠️ Admin Panel</h2>
<h3 style="font-size:15px;">➕ Create Room</h3>
<div style="background:#273449; padding:14px; border-radius:10px;">
<input type="text" id="roomNameInput" placeholder="Room Name">
<select id="roomModeInput">
<option>Solo</option>
<option>Duo</option>
<option>Squad</option>
<option>TDM</option>
</select>
<select id="roomMapInput">
<option>Erangel</option>
<option>Miramar</option>
<option>Sanhok</option>
<option>Warehouse</option>
<option>Arena</option>
</select>
<input type="text" id="roomIdInput" placeholder="Room ID (e.g. 123456)">
<input type="text" id="roomPassInput" placeholder="Password (e.g. ABCD)">
<input type="number" id="roomFeeInput" placeholder="Entry Fee (₹)">
<input type="number" id="roomPrizeInput" placeholder="Prize (₹)">
<input type="text" id="roomTimeInput" placeholder="Start Time (8:00 PM)">
<input type="number" id="roomSlotsInput" placeholder="Total Players">
<button style="background:#22c55e;" onclick="createRoom()">🚀 Create Room</button>
</div>
<button style="background:#dc2626;" onclick="adminLogout()">🚪 Logout</button>
</div>

<div id="mainPage" class="hidden">
<div class="card" style="display:flex; justify-content:space-between; align-items:center;">
<div style="display:flex; align-items:center; gap:10px;">
<div style="background:#3b82f6; width:38px; height:38px; border-radius:50%; display:flex; justify-content:center; align-items:center; font-size:18px;">👤</div>
<div>
<div style="font-weight:bold; font-size:15px;" id="headerName">Loading...</div>
<div style="font-size:11px; color:#94a3b8;">ID: 5552321980</div>
</div>
</div>
<div style="background:#16a34a; padding:6px 12px; border-radius:20px; font-weight:bold; cursor:pointer;" onclick="showWallet()">₹ <span id="walletBalance">500</span></div>
</div>
<div class="card">
<h2>👤 <span id="showName"></span></h2>
<button style="background:#dc2626;" onclick="logout()">Logout</button>
</div>
<div class="card">
<h2>🔥 Available Rooms</h2>
<div id="roomsList">Loading...</div>
</div>
<div class="card">
<button style="background:#ca8a04;" onclick="showLeaderboard()">🏆 Leaderboard</button>
<button style="background:#8b5cf6;" onclick="showMatchHistory()">📜 Match History</button>
<button style="background:#0ea5e9;" onclick="showNotifications()">🔔 Notifications</button>
</div>
</div>

<div class="card hidden" id="joinInputPage">
<h2>🔐 Enter Room Details</h2>
<p style="text-align:center; font-size:14px; color:#94a3b8;">Room: <b id="inputRoomName"></b></p>
<input type="text" id="inputRoomId" placeholder="Enter Room ID">
<input type="text" id="inputRoomPass" placeholder="Enter Password">
<input type="hidden" id="actualRoomId">
<input type="hidden" id="actualRoomPass">
<input type="hidden" id="actualRoomFee">
<input type="hidden" id="actualRoomName">
<button style="background:#22c55e;" onclick="verifyJoin()">✅ Verify & Join</button>
<button style="background:#475569;" onclick="showMain()">⬅️ Back</button>
</div>

<div class="card hidden" id="joinPage">
<h2>🎮 Join Room</h2>
<p>Room: <b id="joinRoomName"></b></p>
<p>ID: <b id="joinRoomId"></b></p>
<p>Password: <b id="joinPassword"></b></p>
<button style="background:#f59e0b;" onclick="startMatch()">✅ Start Match</button>
<button onclick="showMain()">⬅️ Back</button>
</div>

<div class="card hidden" id="matchRoomPage">
<h2>⚔️ Match Room</h2>
<p style="text-align:center; color:#22c55e;">✅ Joined Successfully!</p>
<p style="text-align:center; margin-top:12px; color:#94a3b8;">Match starts in</p>
<div class="timer-text" id="matchTimer">05:00</div>
<button id="submitResultBtn" class="hidden" style="background:#2563eb;" onclick="showResultPage()">🏆 Submit Result</button>
<button style="background:#dc2626;" onclick="cancelMatch()">Cancel</button>
</div>

<div class="card hidden" id="resultPage">
<h2>🏆 Submit Result</h2>
<div style="background:#273449; padding:14px; border-radius:10px;">
<p style="margin:5px 0;">👑 <b id="resultPlayerName">Aryan</b></p>
<button style="background:#22c55e;" onclick="submitResult()">✅ Submit Winner</button>
</div>
<button style="background:#475569;" onclick="showMain()">⬅️ Back</button>
</div>

<div class="card hidden" id="walletPage">
<h2>💰 My Wallet</h2>
<div style="background:#16a34a; padding:18px; border-radius:12px; text-align:center;">
<p style="margin:0; font-size:13px;">Available Balance</p>
<h1 style="margin:5px 0; font-size:38px;">₹<span id="walletPageBalance">500</span></h1>
</div>
<input type="number" id="amountInput" placeholder="Enter amount (₹)" inputmode="numeric">
<div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
<button onclick="addMoney()">➕ Add Money</button>
<button style="background:#dc2626;" onclick="withdrawMoney()">💸 Withdraw</button>
</div>
<button style="background:#475569; margin-top:16px;" onclick="showMain()">⬅️ Back</button>
</div>

<div class="card hidden" id="leaderboardPage">
<h2>🏆 Leaderboard</h2>
<div style="background:#273449; padding:12px; border-radius:10px;">
<div class="lb-row"><div class="lb-rank">🥇</div><div class="lb-name">JONATHANx</div><div class="lb-wins">120 W</div></div>
<div class="lb-row"><div class="lb-rank">🥈</div><div class="lb-name">ScoutLive</div><div class="lb-wins">98 W</div></div>
<div class="lb-row"><div class="lb-rank">🥉</div><div class="lb-name">MortalOG</div><div class="lb-wins">89 W</div></div>
<div class="lb-row"><div class="lb-rank">4</div><div class="lb-name">AryanRajput</div><div class="lb-wins">76 W</div></div>
<div class="lb-row"><div class="lb-rank">5</div><div class="lb-name">GodLikeZ</div><div class="lb-wins">70 W</div></div>
<div class="lb-row"><div class="lb-rank">6</div><div class="lb-name">Neyoo</div><div class="lb-wins">65 W</div></div>
<div class="lb-row"><div class="lb-rank">7</div><div class="lb-name">Shadow</div><div class="lb-wins">60 W</div></div>
<div class="lb-row"><div class="lb-rank">8</div><div class="lb-name">ClutchGod</div><div class="lb-wins">58 W</div></div>
<div class="lb-row"><div class="lb-rank">9</div><div class="lb-name">LEGENDx</div><div class="lb-wins">50 W</div></div>
<div class="lb-row"><div class="lb-rank">10</div><div class="lb-name">KillerOP</div><div class="lb-wins">45 W</div></div>
</div>
<button style="background:#475569; margin-top:16px;" onclick="showMain()">⬅️ Back</button>
</div>

<div class="card hidden" id="matchHistoryPage">
<h2>📜 Match History</h2>
<div id="historyList" style="background:#273449; padding:14px; border-radius:10px;">
<p style="color:#94a3b8; text-align:center;">Loading...</p>
</div>
<button style="background:#475569; margin-top:16px;" onclick="showMain()">⬅️ Back</button>
</div>

<div class="card hidden" id="notificationsPage">
<h2>🔔 Notifications</h2>
<div id="notifList" style="background:#273449; padding:14px; border-radius:10px;">
<p style="color:#94a3b8; text-align:center;">No new notifications.</p>
</div>
<button style="background:#475569; margin-top:16px;" onclick="showMain()">⬅️ Back</button>
</div>

</div>

<script>
function $(id) { return document.getElementById(id); }
function show(id) { $(id).classList.remove('hidden'); }
function hide(id) { $(id).classList.add('hidden'); }
var allPages = ['loginBox','adminBox','adminPanel','mainPage','joinInputPage','joinPage','matchRoomPage','resultPage','walletPage','leaderboardPage','matchHistoryPage','notificationsPage'];
function hideAll() { for (var i = 0; i < allPages.length; i++) { $(allPages[i]).classList.add('hidden'); } }

function login() {
    var name = $("username").value.trim();
    if (!name) { alert("Enter name"); return; }
    localStorage.setItem("bgmiUser", name);
    showMain();
}

function showMain() {
    var name = localStorage.getItem("bgmiUser");
    var wallet = localStorage.getItem("bgmiWallet") || "500";
    hideAll();
    if (name) {
        show("mainPage");
        $("showName").innerText = name;
        $("headerName").innerText = name;
        $("walletBalance").innerText = wallet;
        loadRooms();
    } else {
        show("loginBox");
    }
}

function logout() { localStorage.removeItem("bgmiUser"); location.reload(); }

function adminMode() { hideAll(); show("adminBox"); }

function adminLogin() {
    if ($("adminPassword").value === "admin123") {
        hideAll(); show("adminPanel");
    } else { alert("Wrong password!"); }
}

function adminLogout() { hideAll(); show("loginBox"); }

async function createRoom() {
    var name = $("roomNameInput").value.trim();
    var mode = $("roomModeInput").value;
    var map = $("roomMapInput").value;
    var roomId = $("roomIdInput").value.trim();
    var password = $("roomPassInput").value.trim();
    var fee = $("roomFeeInput").value;
    var prize = $("roomPrizeInput").value;
    var time = $("roomTimeInput").value.trim();
    var slots = $("roomSlotsInput").value;

    if (!name || !roomId || !password || !fee || !prize || !time || !slots) {
        alert("Fill all fields!");
        return;
    }

    if (typeof saveRoomToFirebase === "function") {
        await saveRoomToFirebase(name, mode, map, fee, prize, time, slots, roomId, password);
        alert("✅ Room Created!\n\nRoom ID: " + roomId + "\nPassword: " + password);
        $("roomNameInput").value = "";
        $("roomIdInput").value = "";
        $("roomPassInput").value = "";
        $("roomFeeInput").value = "";
        $("roomPrizeInput").value = "";
        $("roomTimeInput").value = "";
        $("roomSlotsInput").value = "";
    } else {
        alert("Firebase loading... wait 5 seconds and try again.");
    }
}

async function loadRooms() {
    if (typeof getLiveRooms !== "function") {
        $("roomsList").innerHTML = '<p style="color:#94a3b8; text-align:center;">Firebase loading...</p>';
        return;
    }
    try {
        var rooms = await getLiveRooms();
        var list = $("roomsList");
        if (rooms.length === 0) {
            list.innerHTML = '<p style="color:#94a3b8; text-align:center;">No rooms available.</p>';
            return;
        }
        list.innerHTML = "";
        for (var i = 0; i < rooms.length; i++) {
            var r = rooms[i];
            var div = document.createElement("div");
            div.className = "room";
            div.innerHTML = "<h3>🏆 " + r.roomName + "</h3>" +
                "Mode: " + r.mode + "<br>" +
                "Map: " + r.map + "<br>" +
                "Start: " + r.startTime + "<br>" +
                "Fee: ₹" + r.entryFee + "<br>" +
                "Prize: ₹" + r.prize + "<br>" +
                "<button class='join' onclick=\"openJoin('" + r.roomName + "','" + r.roomId + "','" + r.password + "','" + r.entryFee + "')\">Join Room</button>";
            list.appendChild(div);
        }
    } catch (e) {
        $("roomsList").innerHTML = '<p style="color:#dc2626; text-align:center;">Error loading rooms.</p>';
    }
}

function openJoin(name, id, pass, fee) {
    hideAll();
    show("joinInputPage");
    $("inputRoomName").innerText = name;
    $("inputRoomId").value = "";
    $("inputRoomPass").value = "";
    $("actualRoomId").value = id;
    $("actualRoomPass").value = pass;
    $("actualRoomFee").value = fee;
    $("actualRoomName").value = name;
}

function verifyJoin() {
    var enteredId = $("inputRoomId").value.trim();
    var enteredPass = $("inputRoomPass").value.trim();
    var actualId = $("actualRoomId").value.trim();
    var actualPass = $("actualRoomPass").value.trim();
    var fee = parseInt($("actualRoomFee").value);
    var name = $("actualRoomName").value;

    if (enteredId.toUpperCase() !== actualId.toUpperCase()) {
        alert("❌ Wrong Room ID!\n\nYou entered: " + enteredId + "\nCorrect: " + actualId);
        return;
    }
    if (enteredPass.toUpperCase() !== actualPass.toUpperCase()) {
        alert("❌ Wrong Password!\n\nYou entered: " + enteredPass + "\nCorrect: " + actualPass);
        return;
    }

    var wallet = parseInt(localStorage.getItem("bgmiWallet") || "500");
    if (wallet < fee) {
        alert("❌ Insufficient balance!\n\nYour balance: ₹" + wallet + "\nRequired: ₹" + fee);
        return;
    }

    var newBalance = wallet - fee;
    localStorage.setItem("bgmiWallet", newBalance);
    $("walletBalance").innerText = newBalance;
    saveHistory(name, "Joined", "₹" + fee + " deducted");

    alert("✅ Joined!\n\n₹" + fee + " deducted.\nNew balance: ₹" + newBalance);

    hideAll();
    show("joinPage");
    $("joinRoomName").innerText = name;
    $("joinRoomId").innerText = actualId;
    $("joinPassword").innerText = actualPass;
}

function startMatch() {
    hideAll();
    show("matchRoomPage");
    $("submitResultBtn").classList.add("hidden");
    startTimer(5);
}

var timerInterval;
function startTimer(minutes) {
    var total = minutes * 60;
    clearInterval(timerInterval);
    $("matchTimer").innerText = fmt(total);
    timerInterval = setInterval(function() {
        total--;
        if (total <= 0) {
            clearInterval(timerInterval);
            $("matchTimer").innerText = "00:00";
            $("submitResultBtn").classList.remove("hidden");
            return;
        }
        $("matchTimer").innerText = fmt(total);
    }, 1000);
}

function fmt(s) {
    var m = Math.floor(s / 60);
    var x = s % 60;
    return (m < 10 ? '0' + m : m) + ":" + (x < 10 ? '0' + x : x);
}

function cancelMatch() {
    clearInterval(timerInterval);
    hideAll();
    show("mainPage");
}

function showResultPage() {
    clearInterval(timerInterval);
    hideAll();
    show("resultPage");
    var u = localStorage.getItem("bgmiUser") || "Player";
    $("resultPlayerName").innerText = u;
}

function submitResult() {
    var u = localStorage.getItem("bgmiUser") || "Player";
    if (typeof saveResultToFirebase === "function") {
        saveResultToFirebase(u, "Unknown", u);
    }
    saveHistory("Match Result", "Winner: " + u, "Submitted");
    alert("✅ Result submitted! Admin will verify soon.");
    hideAll();
    show("mainPage");
}

function showWallet() {
    var b = localStorage.getItem("bgmiWallet") || "500";
    $("walletPageBalance").innerText = b;
    hideAll();
    show("walletPage");
}

function addMoney() {
    var a = $("amountInput").value.trim();
    if (a === "" || isNaN(a) || parseInt(a) <= 0) { alert("Enter valid amount!"); return; }
    var c = parseInt(localStorage.getItem("bgmiWallet") || "500");
    var n = c + parseInt(a);
    localStorage.setItem("bgmiWallet", n);
    $("walletBalance").innerText = n;
    $("walletPageBalance").innerText = n;
    $("amountInput").value = "";
    saveHistory("Added Money", "₹" + a + " added", "New balance: ₹" + n);
    alert("✅ ₹" + a + " added!\nNew balance: ₹" + n);
}

function withdrawMoney() {
    var a = $("amountInput").value.trim();
    if (a === "" || isNaN(a) || parseInt(a) <= 0) { alert("Enter valid amount!"); return; }
    var c = parseInt(localStorage.getItem("bgmiWallet") || "500");
    if (parseInt(a) > c) { alert("Insufficient balance!"); return; }
    var n = c - parseInt(a);
    localStorage.setItem("bgmiWallet", n);
    $("walletBalance").innerText = n;
    $("walletPageBalance").innerText = n;
    $("amountInput").value = "";
    saveHistory("Withdrawn", "₹" + a + " withdrawn", "New balance: ₹" + n);
    alert("✅ ₹" + a + " withdrawn!\nNew balance: ₹" + n);
}

function showLeaderboard() {
    hideAll();
    show("leaderboardPage");
}

function showMatchHistory() {
    hideAll();
    show("matchHistoryPage");
    var history = JSON.parse(localStorage.getItem("bgmiHistory") || "[]");
    var list = $("historyList");
    if (history.length === 0) {
        list.innerHTML = '<p style="color:#94a3b8; text-align:center;">No match history yet.</p>';
        return;
    }
    list.innerHTML = "";
    for (var i = history.length - 1; i >= 0; i--) {
        var h = history[i];
        var div = document.createElement("div");
        div.style.padding = "8px 0";
        div.style.borderBottom = "1px solid #475569";
        div.innerHTML = "<b>" + h.title + "</b><br><span style='font-size:12px; color:#94a3b8;'>" + h.desc + "</span><br><span style='font-size:11px; color:#60a5fa;'>" + h.date + "</span>";
        list.appendChild(div);
    }
}

function showNotifications() {
    hideAll();
    show("notificationsPage");
    var notifs = JSON.parse(localStorage.getItem("bgmiNotifs") || "[]");
    var list = $("notifList");
    if (notifs.length === 0) {
        list.innerHTML = '<p style="color:#94a3b8; text-align:center;">No new notifications.</p>';
        return;
    }
    list.innerHTML = "";
    for (var i = notifs.length - 1; i >= 0; i--) {
        var n = notifs[i];
        var div = document.createElement("div");
        div.style.padding = "8px 0";
        div.style.borderBottom = "1px solid #475569";
        div.innerHTML = "<b>" + n.title + "</b><br><span style='font-size:12px; color:#94a3b8;'>" + n.desc + "</span><br><span style='font-size:11px; color:#60a5fa;'>" + n.date + "</span>";
        list.appendChild(div);
    }
}

function saveHistory(title, desc, extra) {
    var history = JSON.parse(localStorage.getItem("bgmiHistory") || "[]");
    history.push({
        title: title,
        desc: desc + (extra ? " — " + extra : ""),
        date: new Date().toLocaleString()
    });
    localStorage.setItem("bgmiHistory", JSON.stringify(history));
}

function addNotification(title, desc) {
    var notifs = JSON.parse(localStorage.getItem("bgmiNotifs") || "[]");
    notifs.push({
        title: title,
        desc: desc,
        date: new Date().toLocaleString()
    });
    localStorage.setItem("bgmiNotifs", JSON.stringify(notifs));
}

showMain();
</script>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
import { getFirestore, collection, addDoc, getDocs, query, where } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";

const firebaseConfig = {
    apiKey: "AIzaSyB0w2hQEsJdhyz02A9iK5seyNqMIs77jj0",
    authDomain: "bgmi-arena-71a11.firebaseapp.com",
    projectId: "bgmi-arena-71a11",
    storageBucket: "bgmi-arena-71a11.firebasestorage.app",
    messagingSenderId: "983255287969",
    appId: "1:983255287969:web:af110665c18c77b15848e0"
};

const app = initializeApp(firebaseConfig);
const db = getFirestore(app);

window.saveRoomToFirebase = async function(name, mode, map, fee, prize, time, slots, roomId, password) {
    await addDoc(collection(db, "rooms"), {
        roomName: name, mode: mode, map: map,
        entryFee: parseInt(fee), prize: parseInt(prize),
        startTime: time, totalSlots: parseInt(slots),
        roomId: roomId, password: password, status: "active",
        createdAt: new Date()
    });
};

window.getLiveRooms = async function() {
    var rooms = [];
    var q = query(collection(db, "rooms"), where("status", "==", "active"));
    var snap = await getDocs(q);
    snap.forEach(function(d) {
        var data = d.data();
        rooms.push({
            roomName: data.roomName, mode: data.mode, map: data.map,
            entryFee: data.entryFee, prize: data.prize,
            startTime: data.startTime, totalSlots: data.totalSlots,
            roomId: data.roomId, password: data.password
        });
    });
    return rooms;
};

window.saveResultToFirebase = async function(player1, player2, winner) {
    await addDoc(collection(db, "matchResults"), {
        player1: player1, player2: player2, winner: winner,
        status: "pending", timestamp: new Date()
    });
};

console.log("✅ BGMI Arena Loaded!");
</script>

</body>

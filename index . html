<script>
function $(id) { return document.getElementById(id); }
function show(id) { $(id).classList.remove('hidden'); }
function hide(id) { $(id).classList.add('hidden'); }
var allPages = ['loginBox','adminLoginBox','joinPage','battle1v1Page','team2v2Page','team4v4Page','matchRoomPage','resultPage','walletPage','leaderboardPage','adminPanel','mainPage'];
function hideAll() { allPages.forEach(function(p){ $(p).classList.add('hidden'); }); }

function login() {
var name = $("username").value.trim();
if (name === "") { alert("Please enter your name"); return; }
localStorage.setItem("bgmiUser", name);
showMainPage();
}
function showMainPage() {
var name = localStorage.getItem("bgmiUser");
var wallet = localStorage.getItem("bgmiWallet") || "500";
hideAll();
if (name) {
show("mainPage");
$("showName").innerText = name;
$("headerName").innerText = name;
$("walletBalance").innerText = wallet;
} else { show("loginBox"); }
}
function logout() { localStorage.removeItem("bgmiUser"); location.reload(); }

function showAdminLogin() { hideAll(); show("adminLoginBox"); }
function adminLogin() {
if ($("adminPassword").value === "admin123") {
hideAll(); show("adminPanel"); loadAdminData();
} else { alert("Wrong password!"); }
}
function adminLogout() { hideAll(); show("loginBox"); }
async function loadAdminData() {
$("adminUsers").innerText = "1";
if (typeof getPendingResults === "function") {
try {
var results = await getPendingResults();
$("adminPending").innerText = results.length;
var list = $("pendingResultsList");
list.innerHTML = "";
if (results.length === 0) {
list.innerHTML = '<p style="color:#94a3b8; font-size:13px; text-align:center; padding:15px;">No pending results</p>';
} else {
results.forEach(function(r) {
var div = document.createElement("div");
div.className = "result-row";
div.innerHTML = '<div class="row-top"><span>👑 ' + r.winner + '</span><span style="color:#f59e0b; font-size:11px;">PENDING</span></div><div style="font-size:12px; color:#94a3b8; margin-bottom:8px;">' + r.player1 + ' vs ' + r.player2 + '</div><div class="row-bottom"><button style="background:#22c55e;" onclick="verifyResult(\'' + r.id + '\', \'approved\')">✅ Approve</button><button style="background:#dc2626;" onclick="verifyResult(\'' + r.id + '\', \'rejected\')">❌ Reject</button></div>';
list.appendChild(div);
});
}
} catch (e) { $("pendingResultsList").innerHTML = '<p style="color:#dc2626; font-size:13px; text-align:center; padding:15px;">Error loading</p>'; }
}
}
async function verifyResult(id, status) {
if (typeof updateResultStatus === "function") {
await updateResultStatus(id, status);
alert("Result " + status + "!");
loadAdminData();
}
}

function joinRoom(roomName, roomId, password, entryFee) {
var userName = localStorage.getItem("bgmiUser");
if (!userName) { alert("Please login first!"); return; }
$("joinRoomName").innerText = roomName;
$("joinRoomId").innerText = roomId;
$("joinPassword").innerText = password;
$("joinEntryFee").innerText = "₹" + entryFee;
hideAll(); show("joinPage");
if (typeof saveToFirebase === "function") saveToFirebase(userName, roomName, roomId, password, entryFee);
}

function showSection(sectionName) {
if (sectionName === '1v1') { hideAll(); show("battle1v1Page"); }
else if (sectionName === '2v2') { hideAll(); show("team2v2Page"); }
else if (sectionName === '4v4') { hideAll(); show("team4v4Page"); }
else if (sectionName === 'leaderboard') { hideAll(); show("leaderboardPage"); }
}

function selectMode(m, b) { document.querySelectorAll('.mode-btn').forEach(x=>x.classList.remove('active')); b.classList.add('active'); }
function selectMap(m, b) { document.querySelectorAll('.map-btn').forEach(x=>x.classList.remove('active')); b.classList.add('active'); }
function selectEntry(e, b) { document.querySelectorAll('.entry-btn').forEach(x=>x.classList.remove('active')); b.classList.add('active'); }

function fillSlot(el) { el.classList.add('filled'); el.innerText = '👤 Player'; }
function startTeamMatch(type) { $("matchModeTitle").innerText = type + " Match"; hideAll(); show("matchRoomPage"); startMatchTimer(5); }

function findOpponent() { $("matchModeTitle").innerText = "1v1 TDM"; hideAll(); show("matchRoomPage"); startMatchTimer(5); }
var timerInterval;
function startMatchTimer(minutes) {
var totalSeconds = minutes * 60;
clearInterval(timerInterval);
$("matchTimer").innerText = formatTime(totalSeconds);
timerInterval = setInterval(function() {
totalSeconds--;
if (totalSeconds <= 0) { clearInterval(timerInterval); $("matchTimer").innerText = "00:00"; showResultPage(); return; }
$("matchTimer").innerText = formatTime(totalSeconds);
}, 1000);
}
function formatTime(s) { var m = Math.floor(s/60); var x = s%60; return (m<10?'0'+m:m)+":"+(x<10?'0'+x:x); }
function copyText(t) { if(navigator.clipboard) navigator.clipboard.writeText(t).then(function(){alert("Copied: "+t);}); else alert("Copied: "+t); }
function cancelMatch() { clearInterval(timerInterval); hideAll(); show("mainPage"); }

var selectedWinnerName = "You";
function showResultPage() { clearInterval(timerInterval); hideAll(); show("resultPage"); var u = localStorage.getItem("bgmiUser") || "Player"; $("resultPlayerName").innerText = u; }
function selectWinner(n, b) { document.querySelectorAll('.winner-btn').forEach(x=>x.classList.remove('active')); b.classList.add('active'); selectedWinnerName = n; $("selectedWinner").innerText = n; }
function switchResultTab(t, b) { document.querySelectorAll('.winner-tab').forEach(x=>x.classList.remove('active')); b.classList.add('active'); }
function submitResult() {
var u = localStorage.getItem("bgmiUser") || "Player";
if (typeof saveResultToFirebase === "function") saveResultToFirebase(u, "Unknown", selectedWinnerName);
alert("✅ Result submitted!\nWinner: " + selectedWinnerName);
hideAll(); show("mainPage");
selectedWinnerName = "You";
}

function showWallet() { var b = localStorage.getItem("bgmiWallet") || "500"; $("walletPageBalance").innerText = b; hideAll(); show("walletPage"); }
function addMoney() {
var a = $("amountInput").value.trim();
if (a === "" || isNaN(a) || parseInt(a) <= 0) { alert("Please enter a valid amount!"); return; }
var c = parseInt(localStorage.getItem("bgmiWallet") || "500");
var n = c + parseInt(a);
localStorage.setItem("bgmiWallet", n);
$("walletBalance").innerText = n; $("walletPageBalance").innerText = n;
$("amountInput").value = "";
alert("✅ ₹" + a + " added!\nNew Balance: ₹" + n);
}
function withdrawMoney() {
var a = $("amountInput").value.trim();
if (a === "" || isNaN(a) || parseInt(a) <= 0) { alert("Please enter a valid amount!"); return; }
var c = parseInt(localStorage.getItem("bgmiWallet") || "500");
if (parseInt(a) > c) { alert("❌ Insufficient balance!"); return; }
var n = c - parseInt(a);
localStorage.setItem("bgmiWallet", n);
$("walletBalance").innerText = n; $("walletPageBalance").innerText = n;
$("amountInput").value = "";
alert("✅ ₹" + a + " withdrawn!\nNew Balance: ₹" + n);
}
function referFriend() { var u = localStorage.getItem("bgmiUser") || "Player"; var code = "BGMI" + u.substring(0,4).toUpperCase(); alert("Your Referral Code: " + code); }

function backToMain() { clearInterval(timerInterval); hideAll(); show("mainPage"); }

showMainPage();
</script>


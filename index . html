<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BGMI Arena</title>
<style>
* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0f172a; color: white; -webkit-font-smoothing: antialiased; }
header { background: #1e293b; padding: 16px; text-align: center; }
header h1 { margin: 0; font-size: 24px; }
.container { max-width: 600px; margin: auto; padding: 12px; }
.card { background: #1e293b; padding: 16px; margin-bottom: 12px; border-radius: 15px; }
h2 { text-align: center; margin-top: 0; font-size: 19px; }
input { width: 100%; padding: 13px; margin: 6px 0; border: 0; border-radius: 8px; font-size: 15px; background: #273449; color: white; outline: none; }
input:focus { outline: 2px solid #2563eb; }
button { width: 100%; padding: 13px; margin-top: 8px; border: 0; border-radius: 8px; background: #2563eb; color: white; font-size: 15px; font-weight: 600; transition: transform 0.1s ease; }
button:active { transform: scale(0.98); opacity: 0.9; }
.hidden { display: none !important; }
.profile { background: #312e81; }
.logout { background: #dc2626; }
.room { background: #273449; padding: 14px; margin-top: 12px; border-radius: 12px; }
.room h3 { margin-top: 0; font-size: 15px; }
.info { color: #cbd5e1; line-height: 1.7; font-size: 13px; }
.join { background: #16a34a; }
.notice { text-align: center; color: #94a3b8; font-size: 12px; margin-top: 12px; }
.game-btn { padding: 18px; font-size: 15px; border-radius: 10px; text-align: center; font-weight: 600; }
.btn-blue { background: #2563eb; }
.btn-green { background: #16a34a; }
.btn-yellow { background: #ca8a04; }
.mode-btn, .map-btn, .entry-btn { background: #273449; padding: 10px; font-size: 12px; border: 1px solid #475569; border-radius: 8px; color: white; }
.mode-btn.active, .map-btn.active, .entry-btn.active { background: #2563eb; border-color: #2563eb; }
.winner-tab { background: #273449; padding: 10px; font-size: 13px; border: 1px solid #475569; border-radius: 8px; color: white; }
.winner-tab.active { background: #2563eb; border-color: #2563eb; }
.winner-btn { background: #475569; padding: 6px 16px; border-radius: 8px; color: white; border: none; font-size: 12px; }
.winner-btn.active { background: #22c55e; }
.timer-text { text-align: center; color: #f59e0b; font-size: 40px; margin: 5px 0; font-weight: bold; }
.lb-row { display: flex; align-items: center; padding: 10px 0; border-bottom: 1px solid #334155; }
.lb-rank { width: 35px; font-weight: bold; color: #f59e0b; }
.lb-name { flex: 1; font-size: 14px; }
.lb-wins { color: #22c55e; font-size: 13px; margin-right: 10px; }
.lb-points { color: #60a5fa; font-weight: bold; font-size: 13px; }
.team-slot { background: #273449; border: 2px dashed #475569; padding: 12px; border-radius: 10px; text-align: center; font-size: 13px; color: #94a3b8; margin-bottom: 6px; }
.team-slot.filled { border-style: solid; border-color: #22c55e; color: white; }
.result-row { background: #273449; padding: 12px; border-radius: 10px; margin-bottom: 8px; }
.result-row .row-top { display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 6px; }
.result-row .row-bottom { display: flex; gap: 8px; }
.result-row button { padding: 8px; font-size: 12px; margin-top: 0; }
</style>
</head>
